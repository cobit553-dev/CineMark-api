# Database Configuration
DB_NAME=cinemark_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_here_at_least_256_bits
JWT_EXPIRATION_MS=864000000

# Admin User Configuration
CINEMARK_ADMIN_EMAIL=admin@cinemark.com
CINEMARK_ADMIN_PASSWORD=your_secure_admin_password_here

# Server Port
SERVER_PORT=8081
